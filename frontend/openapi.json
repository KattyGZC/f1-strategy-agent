      "ServerSentEvent": {
        "description": "Represents a single Server-Sent Event.\n\nWhen `yield`ed from a *path operation function* that uses\n`response_class=EventSourceResponse`, each `ServerSentEvent` is encoded\ninto the [SSE wire format](https://html.spec.whatwg.org/multipage/server-sent-events.html#parsing-an-event-stream)\n(`text/event-stream`).\n\nIf you yield a plain object (dict, Pydantic model, etc.) instead, it is\nautomatically JSON-encoded and sent as the `data:` field.\n\nAll `data` values **including plain strings** are JSON-serialized.\n\nFor example, `data=\"hello\"` produces `data: \"hello\"` on the wire (with\nquotes).",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "data": {
            "title": "Data"
          },
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "raw_data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Data"
          },
          "retry": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry"
          }
        },
        "title": "ServerSentEvent",
        "type": "object"
      },
