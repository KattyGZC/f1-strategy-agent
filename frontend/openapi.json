  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/replays": {
      "post": {
        "operationId": "start_replay_api_replays_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartReplayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Start Replay",
        "tags": [
          "replays"
        ]
      }
    },
    "/api/replays/{replay_id}": {
      "get": {
        "operationId": "read_replay_api_replays__replay_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "replay_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Replay Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Replay",
        "tags": [
          "replays"
        ]
      }
    },
    "/api/replays/{replay_id}/events": {
      "get": {
        "description": "The replay's events from the start, or after `Last-Event-ID`, as they fall due. Each\nevent's SSE `event` is its `kind`; the stream ends with `replay_failed` if the replay\nfails, and when the replay expires.",
        "operationId": "watch_replay_api_replays__replay_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "replay_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Replay Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d+-\\d+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/ReplayEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ReplayFailedEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ServerSentEvent"
